# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE
.idea/
.vscode/
*.iml

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/apps/*/node_modules
/packages/*/node_modules

# testing
/coverage

# next.js
/.next/
/out/
/build
/apps/*/.next
/apps/*/out

# turbo
/.turbo

# local files
/local/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
